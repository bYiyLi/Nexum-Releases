{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexum",
  "version": "0.1.0",
  "identifier": "com.nexum.desktop",
  "mainBinaryName": "nexum-desktop",
  "build": {
    "beforeBuildCommand": "node ../../scripts/prepare-desktop-bootstrap.mjs",
    "frontendDist": "../bootstrap"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nexum",
        "width": 1120,
        "height": 720,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "acceptFirstMouse": true,
        "backgroundColor": "#0B0F19",
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../.bootstrap": "bootstrap",
      "../.runtime": "runtime"
    }
  }
}
