{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runtime-ui",
  "description": "Least-privilege IPC bridge for the Runtime-served local management UI.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "remote-runtime-ui"
  ]
}
